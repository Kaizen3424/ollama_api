{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama-proxy/minimax-m3",
  "small_model": "ollama-proxy/minimax-m3",
  "provider": {
    "ollama-proxy": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Proxy",
      "options": {
        "baseURL": "http://localhost:3001/v1",
        "apiKey": "{env:OLLAMA_PROXY_API_KEY}"
      },
      "models": {
        "minimax-m3": {
          "name": "MiniMax M3 (via proxy)",
          "limit": { "context": 128000, "output": 65536 }
        },
        "minimax-m2.7": {
          "name": "MiniMax M2.7 (via proxy)",
          "limit": { "context": 128000, "output": 65536 }
        },
        "qwen3.5:397b": {
          "name": "Qwen 3.5 397B (via proxy)",
          "limit": { "context": 128000, "output": 65536 }
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro (via proxy)",
          "limit": { "context": 128000, "output": 65536 }
        },
        "gpt-oss:120b": {
          "name": "GPT-OSS 120B (via proxy)",
          "limit": { "context": 128000, "output": 65536 }
        }
      }
    }
  }
}

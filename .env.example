PORT=3001
UPSTREAM_BASE=https://ollama.com

# Generate one with: node -e "console.log('sk-'+require('crypto').randomBytes(24).toString('hex'))"
PROXY_API_KEY1=sk-replace-me-1
PROXY_API_KEY2=sk-replace-me-2

# Key management
KEY_COOLDOWN_MS=60000
MAX_KEY_RETRIES=10
KEY_TOKEN_LIMIT_5H=2000000
KEY_TOKEN_LIMIT_WEEK=5000000

# Usage tracking
USAGE_FLUSH_MS=60000

# MongoDB Atlas
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=ollama_proxy

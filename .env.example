# Copy to .env and fill in your values

# Server
PORT=3001
HOST=0.0.0.0

# Upstream Ollama API base URL (cloud)
UPSTREAM_BASE=https://ollama.com

# Client API keys for proxy authentication.
# Generate with: node -e "console.log('sk-'+require('crypto').randomBytes(24).toString('hex'))"
# Accepted via `Authorization: Bearer <key>` or (Anthropic clients) `x-api-key: <key>`.
PROXY_API_KEY1=sk-your-first-client-key
PROXY_API_KEY2=sk-your-second-client-key

# Ollama cloud API keys are read from ollama_keys.txt (one per line)
# key management
KEY_COOLDOWN_MS=60000
MAX_KEY_RETRIES=10
KEY_TOKEN_LIMIT_5H=2000000
KEY_TOKEN_LIMIT_WEEK=5000000

# Usage tracking (MongoDB)
USAGE_FLUSH_MS=60000
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=ollama_proxy

# Logging (optional)
# LOG_LEVEL=info
